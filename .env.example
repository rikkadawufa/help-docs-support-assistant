# Copy this file to .env and fill in the values. Never commit .env.
OPENAI_API_KEY=
SLACK_WEBHOOK_URL=

# mock = no OpenAI calls (fake embeddings + canned replies); live = real API
LLM_MODE=mock
# log = write handoffs to output/handoff-log.jsonl; slack = post to SLACK_WEBHOOK_URL
SLACK_MODE=log

CHAT_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
TOP_K=5
# Set once from eval/calibration.json, see docs/VERIFICATION.md
RELEVANCE_MIN=0.39

# Point the test assistants at another set of documents (Starter audit). Unset = the Cinderpeak demo.
# INDEX_NAME gives those documents their own index; without it, ingest replaces the demo's.
# KNOWLEDGE_DIR=clients/acme
# INDEX_NAME=acme
# BRAND_NAME=Acme Tools
# HANDOFF_REPLY=I couldn't find this in our help pages, so I've sent your question to our team.
# DEGRADED_REPLY=Our assistant is having trouble right now. Please email our team instead.
# Regex for the banner and footer repeated on every PDF page; set to empty to strip nothing.
# A footer may capture (?P<title>...) to label each chunk.
# PAGE_BANNER=
# PAGE_FOOTER=
