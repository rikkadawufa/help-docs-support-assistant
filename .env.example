# Copy this file to .env and fill in the values. Never commit .env.
OPENAI_API_KEY=
SLACK_WEBHOOK_URL=

# mock = no OpenAI calls (fake embeddings + canned replies); live = real API
LLM_MODE=mock
# log = write handoffs to output/handoff-log.jsonl; slack = post to SLACK_WEBHOOK_URL
SLACK_MODE=log

CHAT_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
TOP_K=5
# Set once from eval/calibration.json, see docs/VERIFICATION.md
RELEVANCE_MIN=0.39
